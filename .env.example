# ─────────────────────────────────────────────────────────
#  .env  —  Copy this file to .env and fill in your values
#  NEVER commit the real .env file to Git!
# ─────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string
# Get from: Supabase Dashboard → Project Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT secret — use any long random string (min 32 chars)
JWT_SECRET=change_this_to_a_long_random_secret_string_abc123xyz

# Port (Vercel ignores this; used for local dev only)
PORT=3000

# Node environment
NODE_ENV=development
